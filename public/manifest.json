{
  "manifest_version": 3,
  "name": "英文网页翻译",
  "version": "0.1.0",
  "description": "一键提取英文网页文章并翻译为中文，支持打字机效果展示与译文下载。",
  "permissions": ["storage", "activeTab"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "英文网页翻译（打开侧边栏）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "文章翻译",
    "default_icon": "icons/icon-32.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "en-translation@example.com",
      "strict_min_version": "115.0"
    }
  }
}
